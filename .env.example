# Server settings. UI and API share one origin.
PORT=3000
CORS_ORIGIN=http://localhost:3000
# Local demo storage, relative to the repository root. Use :memory: for disposable tests.
DATA_FILE=data/runtime/startcard.json

# Optional: constructor questions/cards. Empty key enables labelled fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=10000

# Optional: separate OpenAI clarification endpoints (see docs/api-contract.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=10000
